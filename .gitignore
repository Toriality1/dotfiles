# Track only the dotfiles maintained in this repository.
*

!.gitignore
!.install.sh
!.bashrc
!.zshenv

!.config/
!.config/alacritty/
!.config/alacritty/alacritty.toml
!.config/rofi/
!.config/rofi/config.rasi
!.config/dunst/
!.config/dunst/dunstrc
!.config/i3/
!.config/i3/config
!.config/i3/machine.conf
!.config/tmux/
!.config/tmux/tmux.conf
!.config/tmux/clipboard.sh
!.config/zsh/
!.config/zsh/.zshrc

!.config/nvim/
!.config/nvim/init.lua
!.config/nvim/lazy-lock.json
!.config/nvim/stylua.toml
!.config/nvim/lua/
!.config/nvim/lua/toriality/
!.config/nvim/lua/toriality/*.lua
!.config/nvim/lua/toriality/lazy/
!.config/nvim/lua/toriality/lazy/*.lua

# Installer entry points, implementation, documentation, and tests.
!README.md
!install.ps1
!install.sh
!installer/
!installer/*.sh
!installer/*.conf
!installer/*.ps1
!installer/backends/
!installer/backends/*.sh
!installer/backends/*.conf
!tests/
!tests/test_*.sh
!tests/test_*.ps1
